# ═══════════════════════════════════════════════════════════════════
# SAAS MESA — Configuração de Ambiente
# ═══════════════════════════════════════════════════════════════════
# Copie este arquivo como .env e preencha os valores:
#   cp .env.example .env
# Gere a APP_KEY: php artisan key:generate
# ═══════════════════════════════════════════════════════════════════

# ═════════════════════════════════════════
# APLICAÇÃO
# ═════════════════════════════════════════

APP_NAME="SaaS Mesa"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://app.saasmesa.com.br

# Localização
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

# Chaves anteriores (separadas por vírgula) para decrypt de dados antigos
# Útil durante rotação de APP_KEY
# APP_PREVIOUS_KEYS=

# Driver de manutenção (file / cache) e store
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Número de workers para o servidor embutido do PHP (dev)
# PHP_CLI_SERVER_WORKERS=4

# ═════════════════════════════════════════
# BCRYPT
# ═════════════════════════════════════════

BCRYPT_ROUNDS=12

# ═════════════════════════════════════════
# LOG
# ═════════════════════════════════════════

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_DEPRECATIONS_TRACE=false
LOG_LEVEL=warning

# Canal de log para o driver daily (dias de retenção)
# LOG_DAILY_DAYS=14

# Slack — notificações de log
# LOG_SLACK_WEBHOOK_URL=
# LOG_SLACK_USERNAME="${APP_NAME}"
# LOG_SLACK_EMOJI=:boom:

# Papertrail
# PAPERTRAIL_URL=
# PAPERTRAIL_PORT=

# Formatter personalizado para stderr
# LOG_STDERR_FORMATTER=

# ═════════════════════════════════════════
# BANCO DE DADOS
# ═════════════════════════════════════════

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=saas_mesa
DB_USERNAME=
DB_PASSWORD=

# Opcional — URL completa da conexão (substitui host/port/database)
# DB_URL=

# Socket UNIX (usado em vez de host/port quando definido)
# DB_SOCKET=

# Charset e collation
# DB_CHARSET=utf8mb4
# DB_COLLATION=utf8mb4_unicode_ci

# Chave estrangeira habilitada (SQLite)
# DB_FOREIGN_KEYS=true

# SSL CA path (MySQL / MariaDB)
# MYSQL_ATTR_SSL_CA=

# PostgreSQL
# DB_SSLMODE=prefer

# SQL Server
# DB_ENCRYPT=yes
# DB_TRUST_SERVER_CERTIFICATE=false

# ═════════════════════════════════════════
# SESSÃO
# ═════════════════════════════════════════

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.saasmesa.com.br

# Conexão de banco/redis para a sessão (nome da connection em database.php)
# SESSION_CONNECTION=

# Tabela de sessão (driver database)
# SESSION_TABLE=sessions

# Nome do cookie
# SESSION_COOKIE="${APP_NAME}-session"

# Cookie seguro (true em produção com HTTPS)
# SESSION_SECURE_COOKIE=

# Cookie HTTP-only
# SESSION_HTTP_ONLY=true

# Same-Site (lax / strict / none / null)
# SESSION_SAME_SITE=lax

# Cookie particionado (cross-site context)
# SESSION_PARTITIONED_COOKIE=false

# ═════════════════════════════════════════
# BROADCASTING (WebSockets)
# ═════════════════════════════════════════

BROADCAST_CONNECTION=log

# Laravel Reverb (recomendado)
# REVERB_APP_KEY=
# REVERB_APP_SECRET=
# REVERB_APP_ID=
# REVERB_HOST=localhost
# REVERB_PORT=8080
# REVERB_SCHEME=https

# Pusher
# PUSHER_APP_KEY=
# PUSHER_APP_SECRET=
# PUSHER_APP_ID=
# PUSHER_APP_CLUSTER=mt1
# PUSHER_HOST=
# PUSHER_PORT=443
# PUSHER_SCHEME=https

# Ably
# ABLY_KEY=

# ═════════════════════════════════════════
# FILESYSTEM
# ═════════════════════════════════════════

FILESYSTEM_DISK=local

# Amazon S3 (ou compatível)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=
# AWS_URL=
# AWS_ENDPOINT=
# AWS_USE_PATH_STYLE_ENDPOINT=false

# ═════════════════════════════════════════
# FILA (QUEUE)
# ═════════════════════════════════════════

QUEUE_CONNECTION=redis

# Database
# DB_QUEUE_CONNECTION=
# DB_QUEUE_TABLE=jobs
# DB_QUEUE=default
# DB_QUEUE_RETRY_AFTER=90

# Beanstalkd
# BEANSTALKD_QUEUE_HOST=localhost
# BEANSTALKD_QUEUE=default
# BEANSTALKD_QUEUE_RETRY_AFTER=90

# Amazon SQS
# SQS_PREFIX=https://sqs.us-east-1.amazonaws.com/your-account-id
# SQS_QUEUE=default
# SQS_SUFFIX=

# Redis
# REDIS_QUEUE_CONNECTION=default
# REDIS_QUEUE=default
# REDIS_QUEUE_RETRY_AFTER=90

# Driver para armazenar jobs com falha
# QUEUE_FAILED_DRIVER=database-uuids

# ═════════════════════════════════════════
# CACHE
# ═════════════════════════════════════════

CACHE_STORE=redis
# CACHE_PREFIX="${APP_NAME}-cache-"

# Cache via banco de dados
# DB_CACHE_CONNECTION=
# DB_CACHE_TABLE=cache
# DB_CACHE_LOCK_CONNECTION=
# DB_CACHE_LOCK_TABLE=

# Memcached
# MEMCACHED_PERSISTENT_ID=
# MEMCACHED_USERNAME=
# MEMCACHED_PASSWORD=
# MEMCACHED_HOST=127.0.0.1
# MEMCACHED_PORT=11211

# Redis (cache)
# REDIS_CACHE_CONNECTION=cache
# REDIS_CACHE_LOCK_CONNECTION=default

# DynamoDB
# DYNAMODB_CACHE_TABLE=cache
# DYNAMODB_ENDPOINT=

# ═════════════════════════════════════════
# REDIS
# ═════════════════════════════════════════

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Cluster
# REDIS_CLUSTER=redis

# Prefixo das chaves
# REDIS_PREFIX="${APP_NAME}-database-"

# Conexão persistente
# REDIS_PERSISTENT=false

# URL completa (substitui host/port/path)
# REDIS_URL=

# Autenticação
# REDIS_USERNAME=

# Databases
# REDIS_DB=0
# REDIS_CACHE_DB=1

# Backoff / retry
# REDIS_MAX_RETRIES=3
# REDIS_BACKOFF_ALGORITHM=decorrelated_jitter
# REDIS_BACKOFF_BASE=100
# REDIS_BACKOFF_CAP=1000

# ═════════════════════════════════════════
# E-MAIL
# ═════════════════════════════════════════

MAIL_MAILER=smtp
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USERNAME=apikey
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@saasmesa.com.br
MAIL_FROM_NAME="${APP_NAME}"

# Esquema de encriptação (tls / ssl)
# MAIL_SCHEME=

# URL completa do mailer (substitui host/port/username/password)
# MAIL_URL=

# EHLO domain
# MAIL_EHLO_DOMAIN=saasmesa.com.br

# Sendmail
# MAIL_SENDMAIL_PATH="/usr/sbin/sendmail -bs -i"

# Canal de log para o mailer "log"
# MAIL_LOG_CHANNEL=

# ═════════════════════════════════════════
# SERVIÇOS DE TERCEIROS
# ═════════════════════════════════════════

# Postmark
# POSTMARK_API_KEY=

# Resend
# RESEND_API_KEY=

# Slack (notificações)
# SLACK_BOT_USER_OAUTH_TOKEN=
# SLACK_BOT_USER_DEFAULT_CHANNEL=

# ═════════════════════════════════════════
# AUTENTICAÇÃO
# ═════════════════════════════════════════

# Guard padrão
# AUTH_GUARD=web

# Password broker
# AUTH_PASSWORD_BROKER=users

# Modelo de usuário
# AUTH_MODEL=App\Models\User

# Tabela de reset de senha
# AUTH_PASSWORD_RESET_TOKEN_TABLE=password_reset_tokens

# Timeout de confirmação de senha (segundos)
# AUTH_PASSWORD_TIMEOUT=10800

# ═══════════════════════════════════════════════════════════════════
# EFIBANK — SUA CONTA (SAAS)
# Você (dono da plataforma) recebe as mensalidades dos tenants
# via PIX na hora da assinatura, com renovação mensal automática.
#
# Webhook URL (cadastrar no EfiBank):
#   https://app.saasmesa.com.br/webhook/efi/saas
# ═══════════════════════════════════════════════════════════════════

EFI_CLIENT_ID=seu_client_id_aqui
EFI_CLIENT_SECRET=seu_client_secret_aqui
EFI_PIX_KEY=sua_chave_pix_aqui
EFI_SANDBOX=false

# Caminho absoluto do certificado .p12 fornecido pela EfiBank
EFI_CERTIFICATE_PATH=/var/www/certs/efi-producao.p12

# Senha do certificado (.p12)
EFI_CERT_PASSWORD=sua_senha_do_certificado

# Caminho da chave privada (se separada do certificado)
# EFI_KEY_PATH=/var/www/certs/chave.pem
# EFI_KEY_PASSWORD=

# Webhook secret para validar notificações
EFI_WEBHOOK_SECRET=seu_webhook_secret_aqui

# Dias de tolerância antes de suspender tenant inadimplente
EFI_SUSPENSION_AFTER_DAYS=5

# ═══════════════════════════════════════════════════════════════════
# CRIPTOGRAFIA — credenciais dos tenants (AES-256-GCM)
# Cada tenant cadastra a própria conta EfiBank para receber
# pagamentos dos clientes finais (cardápio digital).
# Essas credenciais ficam criptografadas no banco.
# Gere uma chave com: php artisan tenant:generate-encryption-key
# ═══════════════════════════════════════════════════════════════════

TENANT_CREDENTIAL_ENCRYPTION_KEY=

# ═══════════════════════════════════════════════════════════════════
# MULTI-TENANCY
# ═══════════════════════════════════════════════════════════════════

SAAS_MAIN_DOMAIN=saasmesa.com.br
TENANT_SUBDOMAIN_PATTERN=*.saasmesa.com.br

# ═════════════════════════════════════════
# ADMIN
# ═════════════════════════════════════════

# E-mail do administrador (recebe alertas críticos do sistema)
ADMIN_EMAIL=gregorio@saasmesa.com.br

# ═════════════════════════════════════════
# VITE
# ═════════════════════════════════════════

VITE_APP_NAME="${APP_NAME}"
